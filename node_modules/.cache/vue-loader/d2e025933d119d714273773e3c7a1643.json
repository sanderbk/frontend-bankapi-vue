  ></span>\r\n                </div>\r\n                <div class=\"text-center mt-4 form-group\">\r\n                  <button\r\n                    class=\"btn w-100 text-center submit vue-butt btn-success btn-lg\"\r\n                    :disabled=\"loading\"\r\n                  >\r\n                    <span v-if=\"!loading\">Sign in 🔓</span>\r\n                    <span v-else\r\n                      ><i class=\"fa fa-spinner fa-spin\"></i> Signing in...</span\r\n                    >\r\n                  </button>\r\n\r\n                  <span :v-if=\"errorms\" class=\"w-100 text-danger\">{{ errorms }}</span>\r\n                </div>\r\n              </form>\r\n              <a\r\n                @click=\"register()\"\r\n                style=\"\"\r\n                class=\"mt-2 btn w-100 text-center submit vue-butt btn-primary btn-lg\"\r\n              >\r\n                <span>Register</span>\r\n              </a>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n</template>\r\n<script>\r\nimport { mapGetters } from \"vuex\";\r\nexport default {\r\n  name: \"Login\",\r\n  data() {\r\n    return {\r\n      username: \"\",\r\n      password: \"\",\r\n      errorms: \"\",\r\n      loading: false, // Add loading state\r\n    };\r\n  },\r\n  computed: {\r\n    ...mapGetters([\"isLoggedIn\"]),\r\n    ...mapGetters([\"isAdmin\"]),\r\n  },\r\n  methods: {\r\n    register() {\r\n      this.$router.replace(\"/register\");\r\n    },\r\n    login() {\r\n      this.loading = true;\r\n      this.$store\r\n        .dispatch(\"login\", {\r\n          username: this.username,\r\n          password: this.password,\r\n        })\r\n        .then(() => {\r\n          this.loading = false;\r\n          this.$router.replace(\"/home\");\r\n        })\r\n        .catch((error) => {\r\n          this.loading = false;\r\n          if (error.response && error.response.data && error.response.data.reason) {\r\n            this.errorms = error.response.data.reason;\r\n          } else {\r\n            this.errorms = \"An unexpected error occurred. Please try again.\";\r\n          }\r\n        });\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.vue-butt {\r\n  display: inline-block;\r\n}\r\n\r\n.fa-spinner {\r\n  margin-left: 10px;\r\n}\r\n\r\n.ftco-section {\r\n  height: 94vh;\r\n  background: radial-gradient(circle, rgb(238, 238, 238) 0%, rgb(233, 233, 233));\r\n}\r\n</style>\r\n"]}]}