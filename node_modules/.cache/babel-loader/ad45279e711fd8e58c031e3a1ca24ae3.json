div class=\"button-container p-2 my-2\">\r\n        <button @click=\"this.$router.push('/home')\" class=\"py-2 mx-2 btn btn-danger\">\r\n          Go Back\r\n        </button>\r\n      </div>\r\n      <h1 class=\"text-center text-muted\">Here are all users</h1>\r\n      <div class=\"form-check my-3\">\r\n        <div class=\"form-check form-check-inline\">\r\n          <input\r\n            class=\"form-check-input\"\r\n            type=\"radio\"\r\n            name=\"accountFilter\"\r\n            id=\"allAccounts\"\r\n            value=\"\"\r\n            v-model=\"hasAccountsFilter\"\r\n            @change=\"fetchUsers\"\r\n          />\r\n          <label class=\"form-check-label\" for=\"allAccounts\">All</label>\r\n        </div>\r\n        <div class=\"form-check form-check-inline\">\r\n          <input\r\n            class=\"form-check-input\"\r\n            type=\"radio\"\r\n            name=\"accountFilter\"\r\n            id=\"hasAccounts\"\r\n            value=\"true\"\r\n            v-model=\"hasAccountsFilter\"\r\n            @change=\"fetchUsers\"\r\n          />\r\n          <label class=\"form-check-label\" for=\"hasAccounts\">Has Accounts</label>\r\n        </div>\r\n        <div class=\"form-check form-check-inline\">\r\n          <input\r\n            class=\"form-check-input\"\r\n            type=\"radio\"\r\n            name=\"accountFilter\"\r\n            id=\"hasNoAccounts\"\r\n            value=\"false\"\r\n            v-model=\"hasAccountsFilter\"\r\n            @change=\"fetchUsers\"\r\n          />\r\n          <label class=\"form-check-label\" for=\"hasNoAccounts\">Has No Accounts</label>\r\n        </div>\r\n      </div>\r\n      <table class=\"table align-middle mb-0 bg-white shadow-sm\">\r\n        <thead class=\"bg-light\">\r\n          <tr>\r\n            <th>Role</th>\r\n            <th>Status</th>\r\n            <th>Username</th>\r\n            <th>Fullname</th>\r\n            <th>Email</th>\r\n            <th>Phone</th>\r\n            <th>DayLimit</th>\r\n            <th>TransactionLimit</th>\r\n            <th>Actions</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody v-if=\"users\">\r\n          <tr v-for=\"user in users\" :key=\"user.id\" :user=\"user\">\r\n            <td>\r\n              <div class=\"d-flex align-items-center\">\r\n                <div class=\"ms-3\">\r\n                  <td>\r\n                    <span\r\n                      v-if=\"user.userTypes.includes('ROLE_CUSTOMER')\"\r\n                      class=\"badge bg-success text-white\"\r\n                    >\r\n                      Customer\r\n                    </span>\r\n                    <span\r\n                      v-else-if=\"user.userTypes.includes('ROLE_EMPLOYEE')\"\r\n                      class=\"badge bg-warning text-dark\"\r\n                    >\r\n                      Employee\r\n                    </span>\r\n                    <span v-else class=\"badge bg-secondary text-white\"> Unknown </span>\r\n                  </td>\r\n                </div>\r\n              </div>\r\n            </td>\r\n            <td>{{ user.userStatus }}</td>\r\n            <td>\r\n              <p class=\"fw-normal mb-1\">{{ user.username }}</p>\r\n            </td>\r\n            <td>\r\n              <span class=\"badge text-primary badge-success rounded-pill d-inline\">{{\r\n                user.firstname + \" \" + user.lastname\r\n              }}</span>\r\n            </td>\r\n            <td>{{ user.email }}</td>\r\n            <td>{{ user.phone }}</td>\r\n            <td>{{ user.dayLimit }}</td>\r\n            <td>{{ user.transLimit }}</td>\r\n            <td>\r\n              <button\r\n                @click=\"\r\n                  this.$router.push({\r\n                    path: '/addaccount',\r\n                    query: { username: user.username },\r\n                  })\r\n                \"\r\n                class=\"py-2 mx-2 btn btn-primary\"\r\n              >\r\n                ➕ Add new Account\r\n              </button>\r\n              <button\r\n                @click=\"\r\n                  this.$router.push({\r\n                    path: '/edituser',\r\n                    query: { username: user.username },\r\n                  })\r\n                \"\r\n                class=\"py-2 mx-2 btn btn-secondary\"\r\n              >\r\n                ✏️ Edit User\r\n              </button>\r\n              <!-- <button\r\n                @click=\"\r\n                  this.$router.push({\r\n                    path: '/edituser',\r\n                    query: { username: user.username },\r\n                  })\r\n                \"\r\n                class=\"py-2 mx-2 btn btn-warning\"\r\n              >\r\n                ✏️ approve user\r\n              </button> -->\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n      <vue-awesome-paginate\r\n        v-if=\"isAdmin\"\r\n        class=\"w-100\"\r\n        v-model=\"currentPage\"\r\n        :total-items=\"totalElements\"\r\n        :items-per-page=\"size\"\r\n        :max-pages-shown=\"5\"\r\n        @click=\"handlePageChange\"\r\n      />\r\n    </div>\r\n  </section>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"../../axios-auth\";\r\nimport { mapGetters } from \"vuex\";\r\n\r\nexport default {\r\n  name: \"Users\",\r\n  computed: {\r\n    ...mapGetters([\"isAdmin\"]),\r\n  },\r\n  data() {\r\n    return {\r\n      users: [],\r\n      currentPage: 1,\r\n      size: 5,\r\n      totalElements: 0,\r\n      hasAccountsFilter: \"\", // Controls radio button: \"\" (All), \"true\" (Has Accounts), \"false\" (Has No Accounts)\r\n      errored: false,\r\n      loading: false,\r\n    };\r\n  },\r\n  methods: {\r\n    fetchUsers() {\r\n      this.loading = true;\r\n      let token = localStorage.getItem(\"token\");\r\n\r\n      let params = {\r\n        page: this.currentPage - 1, // Backend is 0-indexed\r\n        size: this.size,\r\n        excludeUsername: \"InhollandBank\", // <-- Add this line\r\n      };\r\n\r\n      if (this.hasAccountsFilter !== \"\") {\r\n        params.hasAccounts = this.hasAccountsFilter === \"true\";\r\n      }\r\n\r\n      axios\r\n        .get(\"/users\", {\r\n          headers: {\r\n            Accept: \"application/json\",\r\n            \"Content-Type\": \"application/json\",\r\n            Authorization: `Bearer ${token}`,\r\n          },\r\n          params,\r\n        })\r\n        .then((res) => {\r\n          this.users = res.data.content;\r\n          this.totalElements = res.data.totalElements;\r\n        })\r\n        .catch((error) => {\r\n          console.error(error);\r\n          this.errored = true;\r\n        })\r\n        .finally(() => {\r\n          this.loading = false;\r\n        });\r\n    },\r\n    handlePageChange(newPage) {\r\n      this.currentPage = newPage;\r\n      this.fetchUsers();\r\n    },\r\n  },\r\n  mounted() {\r\n    // Check for filter query parameter\r\n    const filter = this.$route.query.filter;\r\n    if (filter === \"noAccounts\") {\r\n      this.hasAccountsFilter = \"false\"; // Pre-select \"Has No Accounts\"\r\n    }\r\n    this.fetchUsers();\r\n  },\r\n};\r\n</script>\r\n\r\n<style>\r\n.pagination-container {\r\n  background-color: #f0f0f0;\r\n  border-radius: 5px;\r\n  padding: 10px 0px;\r\n}\r\n.paginate-buttons {\r\n  width: 40px;\r\n  height: 40px;\r\n  margin-inline: 5px;\r\n  cursor: pointer;\r\n  border: none;\r\n  background-color: transparent;\r\n  border-radius: 2px;\r\n}\r\n.back-button {\r\n  width: 70px;\r\n}\r\n.next-button {\r\n  width: 70px;\r\n}\r\n.back-button svg {\r\n  transform: rotate(180deg);\r\n}\r\n.active-page {\r\n  background-color: #2980b9;\r\n  color: #fff;\r\n}\r\n.paginate-buttons:hover {\r\n  background-color: #e5e5e5;\r\n}\r\n.active-page:hover {\r\n  background-color: #3b8cc3;\r\n  color: #fff;\r\n}\r\n.back-button:active,\r\n.next-button:active {\r\n  background-color: #dedede;\r\n}\r\n\r\n@media (min-width: 1400px) {\r\n  .container,\r\n  .container-lg,\r\n  .container-md,\r\n  .container-sm,\r\n  .container-xl,\r\n  .container-xxl {\r\n    max-width: 95vw;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AAqJA,OAAOA,KAAI,MAAO,kBAAkB;AACpC,SAASC,UAAS,QAAS,MAAM;AAEjC,eAAe;EACbC,IAAI,EAAE,OAAO;EACbC,QAAQ,EAAE;IACR,GAAGF,UAAU,CAAC,CAAC,SAAS,CAAC;EAC3B,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,WAAW,EAAE,CAAC;MACdC,IAAI,EAAE,CAAC;MACPC,aAAa,EAAE,CAAC;MAChBC,iBAAiB,EAAE,EAAE;MAAE;MACvBC,OAAO,EAAE,KAAK;MACdC,OAAO,EAAE;IACX,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,UAAUA,CAAA,EAAG;MACX,IAAI,CAACF,OAAM,GAAI,IAAI;MACnB,IAAIG,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;MAEzC,IAAIC,MAAK,GAAI;QACXC,IAAI,EAAE,IAAI,CAACZ,WAAU,GAAI,CAAC;QAAE;QAC5BC,IAAI,EAAE,IAAI,CAACA,IAAI;QACfY,eAAe,EAAE,eAAe,CAAE;MACpC,CAAC;MAED,IAAI,IAAI,CAACV,iBAAgB,KAAM,EAAE,EAAE;QACjCQ,MAAM,CAACG,WAAU,GAAI,IAAI,CAACX,iBAAgB,KAAM,MAAM;MACxD;MAEAT,KAAI,CACDqB,GAAG,CAAC,QAAQ,EAAE;QACbC,OAAO,EAAE;UACPC,MAAM,EAAE,kBAAkB;UAC1B,cAAc,EAAE,kBAAkB;UAClCC,aAAa,EAAE,UAAUV,KAAK;QAChC,CAAC;QACDG;MACF,CAAC,EACAQ,IAAI,CAAEC,GAAG,IAAK;QACb,IAAI,CAACrB,KAAI,GAAIqB,GAAG,CAACtB,IAAI,CAACuB,OAAO;QAC7B,IAAI,CAACnB,aAAY,GAAIkB,GAAG,CAACtB,IAAI,CAACI,aAAa;MAC7C,CAAC,EACAoB,KAAK,CAAEC,KAAK,IAAK;QAChBC,OAAO,CAACD,KAAK,CAACA,KAAK,CAAC;QACpB,IAAI,CAACnB,OAAM,GAAI,IAAI;MACrB,CAAC,EACAqB,OAAO,CAAC,MAAM;QACb,IAAI,CAACpB,OAAM,GAAI,KAAK;MACtB,CAAC,CAAC;IACN,CAAC;IACDqB,gBAAgBA,CAACC,OAAO,EAAE;MACxB,IAAI,CAAC3B,WAAU,GAAI2B,OAAO;MAC1B,IAAI,CAACpB,UAAU,CAAC,CAAC;IACnB;EACF,CAAC;EACDqB,OAAOA,CAAA,EAAG;IACR;IACA,MAAMC,MAAK,GAAI,IAAI,CAACC,MAAM,CAACC,KAAK,CAACF,MAAM;IACvC,IAAIA,MAAK,KAAM,YAAY,EAAE;MAC3B,IAAI,CAAC1B,iBAAgB,GAAI,OAAO,EAAE;IACpC;IACA,IAAI,CAACI,UAAU,CAAC,CAAC;EACnB;AACF,CAAC","ignoreList":[]}]}